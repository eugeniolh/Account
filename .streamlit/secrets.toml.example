# Rename this file to secrets.toml for LOCAL testing via Streamlit's own
# secrets loader, OR (recommended) paste its contents into
# Streamlit Community Cloud -> App settings -> Secrets when you deploy.
#
# Get this connection string from Supabase: open your project, click the
# "Connect" button near the top of the page, then choose "Session pooler"
# (sometimes under a "Direct Connection String" tab) - that version is
# IPv4-compatible, which Streamlit Cloud needs.

DATABASE_URL = "postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"
